+class LegacyIdalibDispatcher:
+    """Minimal owner-thread dispatcher for idalib builds without serve()."""
+
+    def __init__(self, kernwin: Any) -> None:
+        self._kernwin = kernwin
+        self._owner_thread_id = threading.get_ident()
+        self._queue: queue.Queue[
+            tuple[Callable[[], int], threading.Event | None, list[Any] | None] | None
+        ] = queue.Queue()
+        self._stop_requested = threading.Event()
+        self._submit_lock = threading.Lock()
+
+    def execute_sync(self, callback: Callable[[], int], flags: int) -> int:
+        fast = self._kernwin.MFF_FAST
+        write = self._kernwin.MFF_WRITE
+        nowait = self._kernwin.MFF_NOWAIT
+        if flags not in {fast, write, fast | nowait}:
+            raise RuntimeError(f"unsupported execute_sync flags: {flags!r}")
+        if threading.get_ident() == self._owner_thread_id and flags != fast | nowait:
+            return callback()
+        if flags == fast | nowait:
+            with self._submit_lock:
+                if self._stop_requested.is_set():
+                    raise RuntimeError("legacy idalib dispatcher stopped")
+                self._queue.put((callback, None, None))
+            return 1
+        done = threading.Event()
+        outcome: list[Any] = []
+        with self._submit_lock:
+            if self._stop_requested.is_set():
+                raise RuntimeError("legacy idalib dispatcher stopped")
+            self._queue.put((callback, done, outcome))
+        done.wait()
+        succeeded, value = outcome
+        if succeeded:
+            return value
+        raise value
+
+    def stop_serving(self) -> None:
+        with self._submit_lock:
+            self._stop_requested.set()
+            stopped_error = RuntimeError("legacy idalib dispatcher stopped")
+            while True:
+                try:
+                    item = self._queue.get_nowait()
+                except queue.Empty:
+                    break
+                if item is None:
+                    continue
+                _callback, done, outcome = item
+                if outcome is not None:
+                    outcome[:] = [False, stopped_error]
+                if done is not None:
+                    done.set()
+            self._queue.put(None)
+
+    def serve(self) -> None:
+        while not self._stop_requested.is_set():
+            item = self._queue.get()
+            if item is None:
+                continue
+            callback, done, outcome = item
+            try:
+                result = callback()
+            except BaseException as exc:  # noqa: BLE001 -- mirror execute_sync propagation
+                if outcome is None:
+                    traceback.print_exception(type(exc), exc, exc.__traceback__)
+                    continue
+                outcome[:] = [False, exc]
+            else:
+                if outcome is not None:
+                    outcome[:] = [True, result]
+            finally:
+                if done is not None:
+                    done.set()
 
 
