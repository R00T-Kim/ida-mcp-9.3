+def test_legacy_idalib_dispatcher_logs_nowait_callback_errors(capsys):
+    kernwin = SimpleNamespace(MFF_FAST=0, MFF_WRITE=2, MFF_NOWAIT=8)
+    dispatcher = LegacyIdalibDispatcher(kernwin)
+
+    def fail() -> int:
+        raise ValueError("async callback failed")
+
+    dispatcher.execute_sync(fail, kernwin.MFF_FAST | kernwin.MFF_NOWAIT)
+    dispatcher.execute_sync(
+        lambda: dispatcher.stop_serving() or 1,
+        kernwin.MFF_FAST | kernwin.MFF_NOWAIT,
+    )
+
+    dispatcher.serve()
+
+    assert "ValueError: async callback failed" in capsys.readouterr().err
+
