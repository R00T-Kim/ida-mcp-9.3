+def test_legacy_idalib_dispatcher_nowait_stop_and_flag_rejection():
+    kernwin = SimpleNamespace(MFF_FAST=0, MFF_WRITE=2, MFF_NOWAIT=8)
+    dispatcher = LegacyIdalibDispatcher(kernwin)
+    owner_thread = threading.get_ident()
+    calls: list[int] = []
+
+    assert (
+        dispatcher.execute_sync(
+            lambda: calls.append(threading.get_ident())
+            or dispatcher.stop_serving()
+            or 1,
+            kernwin.MFF_FAST | kernwin.MFF_NOWAIT,
+        )
+        == 1
+    )
+    with pytest.raises(RuntimeError, match="unsupported execute_sync flags"):
+        dispatcher.execute_sync(lambda: 1, kernwin.MFF_WRITE | kernwin.MFF_NOWAIT)
+
+    dispatcher.serve()
+
+    assert calls == [owner_thread]
+
