+def test_legacy_idalib_runtime_clears_cancelled_on_owner_thread(monkeypatch):
+    owner_thread = threading.get_ident()
+    clear_threads: list[int] = []
+    kernwin = SimpleNamespace(
+        MFF_FAST=0,
+        MFF_WRITE=2,
+        MFF_NOWAIT=8,
+        clr_cancelled=lambda: clear_threads.append(threading.get_ident()),
+        set_cancelled=lambda: None,
+    )
+    dispatcher = LegacyIdalibDispatcher(kernwin)
+    monkeypatch.setitem(sys.modules, "ida_domain", SimpleNamespace())
+    monkeypatch.setitem(
+        sys.modules, "idaapi", SimpleNamespace(get_kernel_version=lambda: "9.3")
+    )
+    monkeypatch.setitem(sys.modules, "ida_kernwin", kernwin)
+    monkeypatch.setitem(sys.modules, "idc", SimpleNamespace(batch=lambda _value: 0))
+    runtime = IDARuntime(
+        backend="idalib",
+        database=object(),
+        analysis_state=AnalysisState(),
+        idb_change_state=IdbChangeState(),
+        execute_sync=dispatcher.execute_sync,
+    )
+    results: list[Any] = []
+
+    def run_request() -> None:
+        results.append(runtime._run_sync(lambda: 42, kind="execute", timeout=1))
+        dispatcher.stop_serving()
+
+    worker = threading.Thread(target=run_request)
+    worker.start()
+    dispatcher.serve()
+    worker.join(timeout=2)
+
+    assert not worker.is_alive()
+    assert results == [42]
+    assert clear_threads
+    assert set(clear_threads) == {owner_thread}
+
