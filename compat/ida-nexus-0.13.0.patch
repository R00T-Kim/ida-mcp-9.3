+def test_runtime_version_requirement_depends_on_backend(
+    gui_runtime, monkeypatch, version, backend, has_execute_sync, accepted
+):
+    monkeypatch.setattr(sys.modules["idaapi"], "get_kernel_version", lambda: version)
+    options = {
+        "backend": backend,
+        "database": object(),
+        "analysis_state": AnalysisState(),
+        "idb_change_state": IdbChangeState(),
+    }
+    if has_execute_sync:
+        options["execute_sync"] = lambda callback, _flags: callback()
+    if accepted:
+        assert IDARuntime(**options).backend == backend
+    else:
+        required = "9.3" if backend == "gui" or has_execute_sync else "9.4"
+        with pytest.raises(RuntimeError) as error:
+            IDARuntime(**options)
+        assert str(error.value) == f"IDA Nexus requires IDA {required} or newer"
