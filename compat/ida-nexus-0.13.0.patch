+def test_legacy_idalib_dispatcher_stop_settles_pending_waiter():
+    kernwin = SimpleNamespace(MFF_FAST=0, MFF_WRITE=2, MFF_NOWAIT=8)
+    dispatcher = LegacyIdalibDispatcher(kernwin)
+    results: list[Any] = []
+
+    def sync_request() -> None:
+        try:
+            dispatcher.execute_sync(lambda: 1, kernwin.MFF_WRITE)
+        except RuntimeError as exc:
+            results.append(exc)
+
+    worker = threading.Thread(target=sync_request)
+    worker.start()
+    deadline = time.monotonic() + 2
+    while dispatcher._queue.empty() and time.monotonic() < deadline:
+        time.sleep(0.01)
+
+    dispatcher.stop_serving()
+    worker.join(timeout=2)
+
+    assert not worker.is_alive()
+    assert len(results) == 1
+    assert str(results[0]) == "legacy idalib dispatcher stopped"
+    rejected: list[str] = []
+
+    def late_request() -> None:
+        for flags in (kernwin.MFF_WRITE, kernwin.MFF_FAST | kernwin.MFF_NOWAIT):
+            try:
+                dispatcher.execute_sync(lambda: 1, flags)
+            except RuntimeError as exc:
+                rejected.append(str(exc))
+
+    late_worker = threading.Thread(target=late_request)
+    late_worker.start()
+    late_worker.join(timeout=2)
+
+    assert not late_worker.is_alive()
+    assert rejected == [
+        "legacy idalib dispatcher stopped",
+        "legacy idalib dispatcher stopped",
+    ]
+
