+def test_legacy_idalib_dispatcher_runs_supported_requests_on_owner_thread():
+    kernwin = SimpleNamespace(MFF_FAST=0, MFF_WRITE=2, MFF_NOWAIT=8)
+    dispatcher = LegacyIdalibDispatcher(kernwin)
+    owner_thread = threading.get_ident()
+    calls: list[tuple[str, int]] = []
+    results: list[Any] = []
+
+    def sync_request() -> None:
+        results.append(
+            dispatcher.execute_sync(
+                lambda: calls.append(("write", threading.get_ident())) or 7,
+                kernwin.MFF_WRITE,
+            )
+        )
+        results.append(
+            dispatcher.execute_sync(
+                lambda: calls.append(("fast", threading.get_ident())) or 9,
+                kernwin.MFF_FAST,
+            )
+        )
+        try:
+            dispatcher.execute_sync(
+                lambda: calls.append(("bad", threading.get_ident()))
+                or (_ for _ in ()).throw(ValueError("boom")),
+                kernwin.MFF_WRITE,
+            )
+        except ValueError as exc:
+            results.append(exc)
+
+    worker = threading.Thread(target=sync_request)
+    worker.start()
+    for _ in range(3):
+        item = dispatcher._queue.get(timeout=2)
+        assert item is not None
+        callback, done, outcome = item
+        try:
+            result = callback()
+        except BaseException as exc:  # noqa: BLE001
+            assert outcome is not None
+            outcome[:] = [False, exc]
+        else:
+            assert outcome is not None
+            outcome[:] = [True, result]
+        assert done is not None
+        done.set()
+    worker.join(timeout=2)
+
+    assert not worker.is_alive()
+    assert results[:2] == [7, 9]
+    assert isinstance(results[2], ValueError)
+    assert calls == [
+        ("write", owner_thread),
+        ("fast", owner_thread),
+        ("bad", owner_thread),
+    ]
+
